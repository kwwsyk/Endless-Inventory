{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {},
  "license": "${mod_license}",
  "icon": "assets/endless_inventory/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.kwwsyk.endinv.fabric.ModInit"
    ],
    "client": [
      "com.kwwsyk.endinv.fabric.ClientModInit"
    ],
    "jei_mod_plugin": [
      "com.kwwsyk.endinv.fabric.integrates.jei.JeiCompat"
    ]
  },
  "mixins": [
    "fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17",
    "minecraft": "${fabric_minecraft_version_range}"
  },
  "suggests": {
    "jei": "*",
    "cloth-config2": "*"
  }
}
